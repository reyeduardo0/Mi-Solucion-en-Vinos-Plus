rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Catch-all: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Test connection document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Roles collection
    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Albaranes (receiving notes)
    match /albaranes/{albaranId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Supplies (consumables)
    match /supplies/{supplyId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Pack Models
    match /pack_models/{modelId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Wine Packs
    match /wine_packs/{packId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Dispatch Notes (salidas)
    match /dispatch_notes/{noteId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Incidents
    match /incidents/{incidentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Mermas
    match /mermas/{mermaId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Production Reports
    match /production_reports/{reportId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Price Lists
    match /price_lists/{priceListId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
